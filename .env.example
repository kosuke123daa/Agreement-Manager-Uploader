# Docusign environment: "demo" (sandbox) or "production"
DOCUSIGN_ENVIRONMENT=demo

# Integration Key (Client ID) from the Docusign Admin / Apps and Keys page
DOCUSIGN_INTEGRATION_KEY=

# The User ID (GUID) of the Docusign account user to impersonate for JWT Grant
DOCUSIGN_USER_ID=

# The target Docusign Account ID (GUID, not the account number)
DOCUSIGN_ACCOUNT_ID=

# RSA private key (PEM) generated alongside the Integration Key's RSA keypair.
# Paste the key with literal \n for line breaks when storing as a single-line
# env var, e.g.: -----BEGIN RSA PRIVATE KEY-----\nMIIEvA...\n-----END RSA PRIVATE KEY-----
DOCUSIGN_PRIVATE_KEY=

# Space-separated OAuth scopes for Bulk Upload + Agreement Manager.
DOCUSIGN_SCOPES="signature impersonation document_uploader_read document_uploader_write adm_store_unified_repo_read adm_store_unified_repo_write public_dms_document_read search_read"

# Optional override if Docusign assigns your account a dedicated API host
# (e.g. https://na4.docusign.net) instead of the shared api(-d).docusign.com
DOCUSIGN_API_BASE_URL=
